# ============================================
# NearHelp Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Database ---
DATABASE_URL=postgresql://nearhelp:nearhelp_dev@localhost:5432/nearhelp
POSTGRES_USER=nearhelp
POSTGRES_PASSWORD=nearhelp_dev
POSTGRES_DB=nearhelp

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# --- Firebase ---
# Path to the Firebase Admin SDK service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or set the JSON directly (alternative to file path)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Push Notifications (FCM) ---
# Automatically uses the Firebase service account above

# --- Security ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
TRACKING_TOKEN_SECRET=change-me-tracking-secret-at-least-32-chars

# --- Rate Limits ---
SOS_RATE_LIMIT_PER_HOUR=3
API_RATE_LIMIT_PER_MINUTE=100
LOCATION_UPDATE_RATE_LIMIT_PER_SECOND=0.2

# --- SOS Configuration ---
SOS_CANCEL_WINDOW_SECONDS=5
SOS_DEFAULT_RADIUS_METERS=1000
SOS_EXPAND_RADIUS_METERS=2000
SOS_EXPAND_DELAY_SECONDS=90
LOCATION_STALENESS_MINUTES=5
AVAILABILITY_PURGE_MINUTES=30

# --- Privacy / Retention ---
INCIDENT_LOCATION_RETENTION_DAYS=30

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development
